{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "desktop-fyi",
  "main": "worker/index.ts",
  "account_id": "183aa6473d53e6c3f29cfa852ebfb58a",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "desktop.fyi", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ADMIN_EMAILS": "joshua@hu.tt",
    "EMAIL_FROM": "desktop.fyi <hello@desktop.fyi>",
    "SITE_URL": "https://desktop.fyi"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "desktop-fyi", "database_id": "08869e6b-8449-41c4-be0d-0c4b0ae02df6", "migrations_dir": "migrations" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BOARD", "class_name": "BoardDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BoardDurableObject"] }
  ],
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "desktop-fyi-uploads" }
  ],
  "send_email": [
    { "name": "EMAIL", "remote": true }
  ]
}
